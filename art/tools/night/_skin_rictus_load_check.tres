[gd_resource type="GDScript" format=3]

[resource]
script/source = "extends SceneTree\nfunc _initialize():\n var a=load(\"res://assets/sprites/characters/rictus/rictus.tres\")\n var b=load(\"res://assets/sprites/characters/rictus/skins/rictus_skin1/rictus_skin1.tres\")\n if not b is SpriteFrames or a.get_animation_names()!=b.get_animation_names():\n  print(\"RESULT: FAIL skin SpriteFrames\")\n  quit(1)\n  return\n print(\"RESULT: OK skin SpriteFrames \", b.get_animation_names().size())\n quit(0)\n"
