[gd_resource type="GDScript" format=3]

[resource]
script/source = "extends SceneTree\nfunc _initialize():\n    var original = load(\"res://assets/sprites/characters/tocsin/tocsin.tres\")\n    var skin = load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_skin1.tres\")\n    if not (original is SpriteFrames) or not (skin is SpriteFrames):\n        print(\"RESULT: FAIL SpriteFrames\")\n        quit(1)\n        return\n    if original.get_animation_names() != skin.get_animation_names():\n        print(\"RESULT: FAIL animations\")\n        quit(1)\n        return\n    for anim in original.get_animation_names():\n        if original.get_frame_count(anim) != skin.get_frame_count(anim) or original.get_animation_speed(anim) != skin.get_animation_speed(anim) or original.get_animation_loop(anim) != skin.get_animation_loop(anim):\n            print(\"RESULT: FAIL frame contract\")\n            quit(1)\n            return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_skin1.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_parts.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_parts_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_torso.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_torso_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_head.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_head_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_neck_steam.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_l.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_r.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_leg_l.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_leg_r.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_clamp.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_clamp_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_fly.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_fly_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_ground.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_arm_ground_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_leg_fly.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_leg_fly_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_leg_ground.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_leg_ground_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_head_fly.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    if not load(\"res://assets/sprites/characters/tocsin/skins/tocsin_skin1/tocsin_head_fly_emission.tres\") is SpriteFrames:\n        print(\"RESULT: FAIL module\")\n        quit(1)\n        return\n    print(\"RESULT: OK\")\n    quit(0)\n"
