[gd_resource type="GDScript" format=3]

[resource]
script/source = "extends SceneTree\nfunc _initialize() -> void:\n    var failed := 0\n    var count := 0\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/regen_rivets.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/regen_rivets_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_clamp.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_clamp_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_fly.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_fly_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_ground.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_ground_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_l.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_l_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_r.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_arm_r_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_blast.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_blast_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head_blast.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head_blast_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head_blast_top.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head_blast_top_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head_fly.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_head_fly_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_fly.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_fly_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_ground.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_ground_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_l.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_l_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_r.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_leg_r_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_neck_steam.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_neck_steam_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_parts.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_parts_emission.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_torso.tres\")\n    count += 1\n    failed += check_frames(\"res://assets/sprites/characters/tocsin/tocsin_torso_emission.tres\")\n    count += 1\n    print(\"T5_RESOURCES: \", count, \" loaded; errors=\", failed)\n    quit(0 if failed == 0 else 1)\nfunc check_frames(path: String) -> int:\n    var sf = ResourceLoader.load(path)\n    if not sf is SpriteFrames:\n        push_error(path)\n        return 1\n    for anim in sf.get_animation_names():\n        if sf.get_frame_count(anim) == 0:\n            return 1\n        for i in range(sf.get_frame_count(anim)):\n            var t = sf.get_frame_texture(anim, i)\n            if t == null or t.get_width() != 192 or t.get_height() != 192:\n                push_error(path + \": invalid logical frame \" + anim)\n                return 1\n            if not t is AtlasTexture or not t.atlas is CanvasTexture:\n                return 1\n    return 0\n"
