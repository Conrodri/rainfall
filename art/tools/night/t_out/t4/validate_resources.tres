[gd_resource type="GDScript" format=3]

[resource]
script/source = "extends SceneTree\nfunc _initialize():\n var failures = 0\n var resources = 0\n var frames = 0\n for f in DirAccess.get_files_at(\"res://assets/sprites/characters/tocsin\"):\n  if not f.ends_with(\".tres\"): continue\n  var r = load(\"res://assets/sprites/characters/tocsin/\" + f)\n  if not r is SpriteFrames:\n   push_error(f + \": invalid SpriteFrames\")\n   failures += 1\n   continue\n  resources += 1\n  for anim in r.get_animation_names():\n   for i in r.get_frame_count(anim):\n    var tex = r.get_frame_texture(anim, i)\n    if not tex is AtlasTexture or not tex.atlas is CanvasTexture:\n     push_error(f + \": missing AtlasTexture / CanvasTexture\")\n     failures += 1\n     continue\n    var canvas = tex.atlas as CanvasTexture\n    if canvas.diffuse_texture == null or (not \"emission\" in f and canvas.normal_texture == null):\n     push_error(f + \": missing diffuse / normal\")\n     failures += 1\n    if tex.region.size != Vector2(192,192):\n     push_error(f + \": invalid cell\")\n     failures += 1\n    frames += 1\n print(\"T4 RESOURCES: \", resources, \" loaded; frames=\", frames, \"; failures=\", failures)\n quit(failures)\n"
