[gd_resource type="GDScript" format=3]

[resource]
script/source = "extends SceneTree\nfunc _initialize() -> void:\n    var failed := 0\n    var count := 0\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/regen_rivets.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/regen_rivets_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_arm_l.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_arm_l_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_arm_r.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_arm_r_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_head.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_head_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_leg_l.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_leg_l_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_leg_r.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_leg_r_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_neck_steam.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_neck_steam_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_torso.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    if not ResourceLoader.load(\"res://assets/sprites/characters/tocsin/tocsin_torso_emission.tres\") is SpriteFrames:\n        failed += 1\n    count += 1\n    print(\"T3_ALL_RESOURCES: \", count, \" loaded; errors=\", failed)\n    quit(0 if failed == 0 else 1)\n"
