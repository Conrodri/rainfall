[gd_resource type="GDScript" format=3]

[resource]
script/source = "extends SceneTree\nfunc _initialize() -> void:\n    var failed := 0\n    var count := 0\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/knife/knife.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/knife/knife_emission.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/knife_planted/knife_planted.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/knife_planted/knife_planted_emission.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/dagger_arc/dagger_arc.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/dagger_arc/dagger_arc_emission.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/spin_blur/spin_blur.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/spin_blur/spin_blur_emission.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/double_burst/double_burst.tres\") == null:\n        failed += 1\n    count += 1\n    if ResourceLoader.load(\"res://assets/sprites/characters/rictus/double_burst/double_burst_emission.tres\") == null:\n        failed += 1\n    count += 1\n    print(\"M3_RESOURCES: \", count, \" loaded; errors=\", failed)\n    quit(0 if failed == 0 else 1)\n"
