    },
    "coeur_de_glace": {
      "name": "Cœur de glace",
      "quality": "rare",
      "effect_text": "Les monstres ralentis subissent +50 % de dégâts (+25 % par exemplaire)"
    },
    "coeur_de_mousse": {
      "name": "Cœur de mousse",
      "quality": "commun",
      "effect_text": "Régénération +1 PV/s (augmente avec le niveau)"
    },
    "coeur_du_chronomancien": {
      "name": "Cœur du chronomancien",
      "quality": "legendaire",
      "effect_text": "10 kills en 3 s : recharge remise à zéro d'un sort aléatoire (délai interne de 2 s)"
    },
    "couronne_d_echo": {
      "name": "Couronne d'écho",
      "quality": "legendaire",
