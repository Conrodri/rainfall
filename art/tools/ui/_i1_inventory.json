    },
    "aimant_de_poche": {
      "name": "Aimant de poche",
      "quality": "commun",
      "effect_text": "Rayon de ramassage +40 % et XP gagnée +10 % (bonus d'XP plafonné à +100 % au total)"
    },
    "amulette_de_cuir": {
      "name": "Amulette de cuir",
      "quality": "commun",
      "effect_text": "+10 d'armure (réduction = armure / (armure + 100))"
    },
    "antidote": {
      "name": "Antidote",
      "quality": "commun",
      "effect_text": "Dégâts de brûlure et de poison subis réduits (20 % pour 1 exemplaire, hyperbolique)"
    },
    "armure_du_colosse": {
      "name": "Armure du colosse",
