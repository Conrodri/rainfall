    },
    "carquois_affute": {
      "name": "Carquois affûté",
      "quality": "peu_commun",
      "effect_text": "+25 % de vitesse d'attaque (sort 1) et +30 % de vitesse de projectile"
    },
    "chronometre_brise": {
      "name": "Chronomètre brisé",
