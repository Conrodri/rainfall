[gd_resource type="GDScript" format=3]

[resource]
script/source = "extends SceneTree\nfunc _initialize():\n    var paths = [\"res://assets/sprites/characters/averse/averse.tres\", \"res://assets/sprites/characters/averse/averse_emission.tres\", \"res://assets/sprites/characters/averse/effects/crue_ring/crue_ring.tres\", \"res://assets/sprites/characters/averse/effects/crue_ring/crue_ring_emission.tres\", \"res://assets/sprites/characters/averse/effects/goutte_lame/goutte_lame.tres\", \"res://assets/sprites/characters/averse/effects/goutte_lame/goutte_lame_emission.tres\", \"res://assets/sprites/characters/averse/effects/puddle_mirror/puddle_mirror.tres\", \"res://assets/sprites/characters/averse/effects/puddle_mirror/puddle_mirror_emission.tres\", \"res://assets/sprites/characters/averse/effects/wave_cone/wave_cone.tres\", \"res://assets/sprites/characters/averse/effects/wave_cone/wave_cone_emission.tres\"]\n    var total = 0\n    for path in paths:\n        var sf = load(path)\n        assert(sf is SpriteFrames, path)\n        for anim in sf.get_animation_names():\n            assert(sf.get_frame_count(anim) > 0)\n            for i in range(sf.get_frame_count(anim)):\n                var tex = sf.get_frame_texture(anim, i)\n                assert(tex is AtlasTexture, path)\n                assert(tex.atlas != null)\n                if not path.ends_with(\"_emission.tres\"):\n                    assert(tex.atlas is CanvasTexture, path)\n                    assert(tex.atlas.diffuse_texture != null and tex.atlas.normal_texture != null)\n                total += 1\n    print(\"AV2 RESOURCE RESULT: OK / \", paths.size(), \" resources / \", total, \" textures\")\n    quit()\n"
